{
  "name": "pet-viewer-for-codex",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.7.0",
  "publisher": "yutat23",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "yutat23"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yutat23/pet-viewer-for-codex.git"
  },
  "homepage": "https://github.com/yutat23/pet-viewer-for-codex#readme",
  "bugs": {
    "url": "https://github.com/yutat23/pet-viewer-for-codex/issues"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#071217",
    "theme": "dark"
  },
  "keywords": [
    "codex",
    "pet",
    "mascot",
    "animation",
    "terminal"
  ],
  "activationEvents": [
    "onView:codexPet.panelView",
    "onCommand:codexPet.selectPet",
    "onCommand:codexPet.selectBackground",
    "onCommand:codexPet.selectCustomBackground",
    "onCommand:codexPet.selectBackgroundOpacity",
    "onCommand:codexPet.selectAnimationSpeed",
    "onCommand:codexPet.selectSize",
    "onCommand:codexPet.setIdle",
    "onCommand:codexPet.setRunning",
    "onCommand:codexPet.setWaiting",
    "onCommand:codexPet.setReview",
    "onCommand:codexPet.setFailed",
    "onCommand:codexPet.refreshPets",
    "onCommand:codexPet.openPetsDirectory",
    "onCommand:codexPet.startAppServer",
    "onCommand:codexPet.stopAppServer",
    "onCommand:codexPet.restartAppServer",
    "onCommand:codexPet.installHooks",
    "onCommand:codexPet.uninstallHooks",
    "onCommand:codexPet.openHooksConfiguration"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "codexPet.panelContainer",
          "title": "%view.containerTitle%",
          "icon": "media/paw.svg"
        }
      ]
    },
    "views": {
      "codexPet.panelContainer": [
        {
          "id": "codexPet.panelView",
          "name": "%view.name%",
          "type": "webview",
          "icon": "media/paw.svg",
          "contextualTitle": "%extension.displayName%"
        }
      ]
    },
    "commands": [
      {
        "command": "codexPet.selectPet",
        "title": "%command.changePet%",
        "category": "%extension.displayName%",
        "icon": "$(list-selection)"
      },
      {
        "command": "codexPet.selectBackground",
        "title": "%command.changeBackground%",
        "category": "%extension.displayName%",
        "icon": "$(symbol-color)"
      },
      {
        "command": "codexPet.selectCustomBackground",
        "title": "%command.changeCustomBackground%",
        "category": "%extension.displayName%",
        "icon": "$(file-media)"
      },
      {
        "command": "codexPet.selectBackgroundOpacity",
        "title": "%command.changeBackgroundOpacity%",
        "category": "%extension.displayName%",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "codexPet.selectAnimationSpeed",
        "title": "%command.changeAnimationSpeed%",
        "category": "%extension.displayName%",
        "icon": "$(dashboard)"
      },
      {
        "command": "codexPet.selectSize",
        "title": "%command.changeSize%",
        "category": "%extension.displayName%",
        "icon": "$(screen-full)"
      },
      {
        "command": "codexPet.setIdle",
        "title": "%command.setIdle%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.setRunning",
        "title": "%command.setRunning%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.setWaiting",
        "title": "%command.setWaiting%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.setReview",
        "title": "%command.setReview%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.setFailed",
        "title": "%command.setFailed%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.refreshPets",
        "title": "%command.refreshPets%",
        "category": "%extension.displayName%",
        "icon": "$(refresh)"
      },
      {
        "command": "codexPet.openPetsDirectory",
        "title": "%command.openPetsDirectory%",
        "category": "%extension.displayName%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codexPet.previewPet",
        "title": "%command.openPetPreview%",
        "category": "%extension.displayName%",
        "icon": "$(open-preview)"
      },
      {
        "command": "codexPet.startAppServer",
        "title": "%command.startAppServer%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.stopAppServer",
        "title": "%command.stopAppServer%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.restartAppServer",
        "title": "%command.restartAppServer%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.installHooks",
        "title": "%command.installHooks%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.uninstallHooks",
        "title": "%command.uninstallHooks%",
        "category": "%extension.displayName%"
      },
      {
        "command": "codexPet.openHooksConfiguration",
        "title": "%command.openHooksConfiguration%",
        "category": "%extension.displayName%"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "codexPet.selectPet",
          "when": "(webviewId == 'codexPet.panelView' || webviewId == 'codexPet.preview') && webviewSection == 'pet'",
          "group": "navigation@1"
        },
        {
          "command": "codexPet.selectBackground",
          "when": "(webviewId == 'codexPet.panelView' || webviewId == 'codexPet.preview') && webviewSection == 'pet'",
          "group": "navigation@2"
        },
        {
          "command": "codexPet.selectAnimationSpeed",
          "when": "(webviewId == 'codexPet.panelView' || webviewId == 'codexPet.preview') && webviewSection == 'pet'",
          "group": "navigation@5"
        },
        {
          "command": "codexPet.selectSize",
          "when": "(webviewId == 'codexPet.panelView' || webviewId == 'codexPet.preview') && webviewSection == 'pet'",
          "group": "navigation@6"
        },
        {
          "command": "codexPet.selectCustomBackground",
          "when": "(webviewId == 'codexPet.panelView' || webviewId == 'codexPet.preview') && webviewSection == 'pet' && config.codexPet.background == custom",
          "group": "navigation@3"
        },
        {
          "command": "codexPet.selectBackgroundOpacity",
          "when": "(webviewId == 'codexPet.panelView' || webviewId == 'codexPet.preview') && webviewSection == 'pet' && config.codexPet.background == custom",
          "group": "navigation@4"
        }
      ],
      "view/title": [
        {
          "command": "codexPet.refreshPets",
          "when": "view == codexPet.panelView",
          "group": "navigation@1"
        },
        {
          "command": "codexPet.openPetsDirectory",
          "when": "view == codexPet.panelView",
          "group": "navigation@2"
        },
        {
          "command": "codexPet.previewPet",
          "when": "view == codexPet.panelView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "codexPet.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%"
        },
        "codexPet.petDirectory": {
          "type": "string",
          "default": "",
          "description": "%config.petDirectory%"
        },
        "codexPet.scale": {
          "default": 1,
          "anyOf": [
            {
              "type": "string",
              "enum": ["auto"],
              "enumDescriptions": ["%size.autoDescription%"]
            },
            {
              "type": "number",
              "minimum": 0.25,
              "maximum": 3
            }
          ],
          "description": "%config.scale%"
        },
        "codexPet.background": {
          "type": "string",
          "enum": ["none", "custom", "arcade", "autumn-forest", "blue-sky", "office", "pro-office", "grassland", "japanese-festival", "japanese-room", "living-room", "night-camp", "night-city", "space", "rainy-cafe", "treehouse", "server-room", "snowy-cabin", "sunset", "terminal", "tropical-beach", "underwater"],
          "enumDescriptions": [
            "%background.none%",
            "%background.custom%",
            "%background.arcade%",
            "%background.autumnForest%",
            "%background.blueSky%",
            "%background.office%",
            "%background.proOffice%",
            "%background.grassland%",
            "%background.japaneseFestival%",
            "%background.japaneseRoom%",
            "%background.livingRoom%",
            "%background.nightCamp%",
            "%background.nightCity%",
            "%background.space%",
            "%background.rainyCafe%",
            "%background.treehouse%",
            "%background.serverRoom%",
            "%background.snowyCabin%",
            "%background.sunset%",
            "%background.terminal%",
            "%background.tropicalBeach%",
            "%background.underwater%"
          ],
          "default": "grassland",
          "description": "%config.background%"
        },
        "codexPet.customBackground.imagePath": {
          "type": "string",
          "default": "",
          "description": "%config.customBackgroundImagePath%"
        },
        "codexPet.customBackground.opacity": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "%config.customBackgroundOpacity%"
        },
        "codexPet.animationSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 3,
          "description": "%config.animationSpeed%"
        },
        "codexPet.pauseWhenHidden": {
          "type": "boolean",
          "default": true,
          "description": "%config.pauseWhenHidden%"
        },
        "codexPet.watchPetDirectory": {
          "type": "boolean",
          "default": true,
          "description": "%config.watchPetDirectory%"
        },
        "codexPet.integrationMode": {
          "type": "string",
          "enum": ["manual", "appServer", "hooks"],
          "enumDescriptions": [
            "%integration.manual%",
            "%integration.appServer%",
            "%integration.hooks%"
          ],
          "default": "manual",
          "description": "%config.integrationMode%"
        },
        "codexPet.appServer.executable": {
          "type": "string",
          "default": "codex",
          "description": "%config.appServerExecutable%"
        },
        "codexPet.appServer.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%config.appServerAutoStart%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm test && npm run build",
    "build": "node esbuild.mjs --production",
    "check": "tsc --noEmit",
    "compile": "node esbuild.mjs",
    "test": "vitest run",
    "watch": "node esbuild.mjs --watch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
